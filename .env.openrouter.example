# ── OpenAI-compatible API (OpenRouter, OpenAI, or any compatible endpoint) ───
# No Ollama needed. Get your OpenRouter API key at: https://openrouter.ai/keys
# Browse available models at: https://openrouter.ai/models
#
# To use plain OpenAI instead, set:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o

LLM_PROVIDER=openai
OPENAI_API_KEY=sk-or-v1-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=anthropic/claude-3-5-sonnet

# Session lifetime in seconds (default: 1 hour)
SESSION_TTL_SECONDS=3600
